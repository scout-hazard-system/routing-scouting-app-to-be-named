<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_main"
    android:orientation="vertical"
    android:padding="14dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/app_name"
        android:textColor="@color/text_primary"
        android:textSize="21sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:text="@string/app_subtitle"
        android:textColor="@color/text_muted"
        android:textSize="13sp" />
    <dev.warp.scannerstream.MatrixMapView
        android:id="@+id/matrixMapView"
        android:layout_width="match_parent"
        android:layout_height="260dp"
        android:layout_marginTop="10dp" />

    <EditText
        android:id="@+id/baseUrlInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@color/bg_surface"
        android:hint="@string/base_url_hint"
        android:inputType="textUri"
        android:padding="10dp"
        android:text="http://192.168.1.100:18080"
        android:textColor="@color/text_primary"
        android:textColorHint="@color/text_muted" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingTop="8dp">

        <Button
            android:id="@+id/connectBtn"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:backgroundTint="@color/accent"
            android:textAllCaps="false"
            android:text="@string/connect" />

        <Button
            android:id="@+id/disconnectBtn"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:backgroundTint="@color/bg_surface"
            android:textAllCaps="false"
            android:text="@string/disconnect" />
    </LinearLayout>

    <Button
        android:id="@+id/clearLogBtn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:backgroundTint="@color/bg_surface"
        android:text="@string/clear_log"
        android:textAllCaps="false" />
    <Button
        android:id="@+id/openMapsBtn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:backgroundTint="@color/accent"
        android:text="@string/open_maps"
        android:textAllCaps="false" />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/toggle3dBtn"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:backgroundTint="@color/accent"
            android:text="@string/map_3d_enabled"
            android:textAllCaps="false" />

        <Button
            android:id="@+id/drawRouteBtn"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:backgroundTint="@color/bg_surface"
            android:text="@string/draw_route"
            android:textAllCaps="false" />
    </LinearLayout>

    <TextView
        android:id="@+id/statusText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/status_label"
        android:textSize="14sp"
        android:textColor="@color/text_muted"
        android:textStyle="bold" />
    <TextView
        android:id="@+id/drivingModeText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/driving_mode_label"
        android:textSize="13sp"
        android:textColor="@color/text_muted" />
    <TextView
        android:id="@+id/mapTargetText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:text="@string/map_target_none"
        android:textSize="12sp"
        android:textColor="@color/text_muted" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:background="@color/bg_surface"
        android:layout_weight="1">

        <TextView
            android:id="@+id/outputText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/stream_placeholder"
            android:padding="10dp"
            android:textSize="13sp"
            android:textColor="@color/text_primary"
            android:textIsSelectable="true"
            android:typeface="monospace" />
    </ScrollView>
</LinearLayout>
