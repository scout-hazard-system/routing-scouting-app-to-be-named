# /etc/scout-sources.env  (root:scout 640 — never commit real keys)
# Area of interest (follows the vehicle later; static for the hub today)
SCOUT_SOURCES_LAT=33.4484
SCOUT_SOURCES_LON=-112.0740
SCOUT_SOURCES_RADIUS_KM=80
# USPS codes for state feeds (511 + WZDx); any continental state works for WZDx
SCOUT_SOURCES_STATES=AZ
SCOUT_SOURCES_PROVIDERS=nws,wzdx,511,tomtom
# Emit into the pipeline log the map server streams (/api/pipeline/stream)
SCOUT_SOURCES_LOG_FILE=/tmp/pipeline_live_doordash.log
# Host signing key for event accountability (openssl rand -hex 32)
SCOUT_SOURCES_SIGNING_KEY=
SCOUT_SOURCES_USER_AGENT=ScoutHazardSystem/0.1 (contact: you@example.com)
# Optional keys — providers stay inert until set
# SCOUT_511_KEY_AZ=
# SCOUT_511_KEY_UT=
# SCOUT_TOMTOM_KEY=
# SCOUT_TOMTOM_MIN_INTERVAL_S=600   # free tier ~2,500 req/day; each poll = 1 request per tile
# Optional: also write to the scout blackboard (role alert token)
# SCOUT_SOURCES_BLACKBOARD=1
# SCOUT_BLACKBOARD_URL=http://10.66.0.1:8765
# SCOUT_BLACKBOARD_TOKEN_ALERT=
