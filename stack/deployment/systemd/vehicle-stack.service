[Unit]
Description=Vehicle Scanner Stack (pipeline + backend + UI)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=@ROOT_DIR@
Environment=VEHICLE_STACK_CONFIG_FILE=@ROOT_DIR@/stack/config/vehicle_stack.env
ExecStart=@ROOT_DIR@/stack/commands/run_vehicle_stack.sh start
ExecStop=@ROOT_DIR@/stack/commands/run_vehicle_stack.sh stop
ExecReload=@ROOT_DIR@/stack/commands/run_vehicle_stack.sh restart
Restart=on-failure
RestartSec=10
StartLimitIntervalSec=120
StartLimitBurst=5

[Install]
WantedBy=default.target
