[Unit]
Description=Scout Blackboard (key-authorized multi-device store; map-server hub)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=@BB_ENV@
Environment=PYTHONPATH=@PYTHONPATH@
WorkingDirectory=@BB_DIR@
ExecStart=@VENV_PY@ -m scout_crew.blackboard.server
Restart=on-failure
RestartSec=5
StartLimitIntervalSec=120
StartLimitBurst=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=default.target