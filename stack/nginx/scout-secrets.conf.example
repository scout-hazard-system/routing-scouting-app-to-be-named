# /etc/nginx/scout-secrets.conf  (root:www-data, mode 640 — NEVER commit)
# Generated by install-edge.sh. Values must match the upstream services:
#   imagoro serve   IMAGORO_SERVE_TOKEN
#   scout backend   BACKEND_PULL_API_KEY
map "" $imagoro_serve_token { default "REPLACE_WITH_IMAGORO_SERVE_TOKEN"; }
map "" $scout_pull_key      { default "REPLACE_WITH_BACKEND_PULL_API_KEY"; }
