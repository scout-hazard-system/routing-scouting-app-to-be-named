# Vehicle Stack runtime configuration
# Copy and edit values per environment as needed.

# Pipeline integration
PIPELINE_LOG=/tmp/pipeline_live_doordash.log
ENABLE_PIPELINE_AUTOSTART=true
PIPELINE_MODE=broadcastify
# Optional routes (direct/scrcpy/audiorelay/voicemeeter) are disabled in scanner-base by default.
# To use an optional route, pass --enable-optional-audio-routes via PIPELINE_EXTRA_ARGS.
PIPELINE_EXTRA_ARGS='--channels-file /home/gibi/Desktop/stack/config/broadcastify_channels.active.json --selector-city "Phoenix" --selector-county "Maricopa County" --selector-state "AZ" --selector-lat 33.4484 --selector-lon -112.074 --selector-use-ollama-rerank --selector-ollama-model scout-rank'
BROADCASTIFY_CHANNELS_FILE=/home/gibi/Desktop/stack/config/broadcastify_channels.active.json
BROADCASTIFY_SELECTOR_CITY="Phoenix"
BROADCASTIFY_SELECTOR_COUNTY="Maricopa County"
BROADCASTIFY_SELECTOR_STATE="AZ"
BROADCASTIFY_SELECTOR_LOCK_STATE=true
BROADCASTIFY_SELECTOR_DESIRED_TYPES=law,dispatch
BROADCASTIFY_SELECTOR_USE_OLLAMA_RERANK=true
BROADCASTIFY_SELECTOR_OLLAMA_MODEL=scout-rank

# API/UI ports
BACKEND_PORT=18080
FRONTEND_PORT=8787
FRONTEND_EXECUTABLE_PATH=/home/gibi/Desktop/navigation/frontend/dist/scanner-frontend-lite/scanner-frontend-lite
FRONTEND_BUILD_ON_START=true
USE_DOCKER_SERVERS=false
DOCKER_COMPOSE_FILE=/home/gibi/Desktop/stack/docker-compose.server.yml

# Java backend networking
JAVA_BACKEND_HOST=0.0.0.0
WAZE_HAZARDS_API_URL=
WAZE_HAZARDS_API_AUTH_HEADER=Authorization
WAZE_HAZARDS_API_AUTH_PREFIX='Bearer '
WAZE_HAZARDS_API_KEY=

# Log retention
MAX_LOG_SIZE_MB=32
MAX_LOG_BACKUPS=5
JURISDICTION_SCOPE_FILE=/home/gibi/Desktop/stack/config/jurisdiction_scope.active.json
JURISDICTION_STATE=AZ
MAP_SHARD_STATE=AZ
