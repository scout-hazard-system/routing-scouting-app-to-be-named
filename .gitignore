# Python caches
__pycache__/
*.py[cod]

# Local virtual environments / toolchains
cop_pipeline/
.android-toolchain/

# Frontend/backend/android build outputs
navigation/frontend/dist/
navigation/backend/dist/
navigation/backend/*.class
navigation/android/**/build/
navigation/android/app/build/
navigation/android/.gradle/

# Local temp artifacts
buffer_chunk.wav
buffer_chunk.wav.ts
**/buffer_chunk.wav
**/buffer_chunk.wav.ts
pipeline_stress_fallback_report.csv

# UI dumps / adb artifacts / screenshots
window_dump*.xml
**/window_dump*.xml
wireless_*.xml
scout_query_result.png
CLUSTERTEST.png
*.png
!docs/**/*.png

# Local device / debug notes
moto_*.txt
mobile_status.txt
TERMIUS_DEBUG_LOG_GUIDE.txt
docs/guides/TERMIUS_DEBUG_LOG_GUIDE.txt

# Nested Scout CrewAI project (own git remote: scout_crew)
scout_crew/

# Local stack backup snapshots
stack/config/*.bak_*
stack/config/*.bak

# Scout Mesh runtime secrets
stack/mesh/state/
stack/mesh/peers/*.conf
!stack/mesh/peers/.gitkeep

# Packaged map-server deploy bundle.
# The extracted scout-map-server-deploy/ tree is tracked (the PXE stack deploys from
# it), but the single-file archive duplicates that same content, is ~107 MB, and
# exceeds GitHub's 100 MiB per-file hard limit -- so it can never be pushed.
# Re-archive it locally from the tracked tree if you need a single-file copy.
scout-map-server-deploy.zip
