#!/usr/bin/env bash
# scout — local token router (Ollama + CrewAI). Never uses cloud LLM endpoints.
# Debian/XFCE compatible version
set -u

# Resolve symlinks so ROOT is the project even when invoked via ~/.local/bin/scout
SOURCE="${BASH_SOURCE[0]}"
while [[ -L "$SOURCE" ]]; do
  DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  [[ "$SOURCE" != /* ]] && SOURCE="$DIR/$SOURCE"
done
ROOT="$(cd -P "$(dirname "$SOURCE")/.." && pwd)"

# Support both project-local venv and system-wide install
if [[ -x "$ROOT/.venv/bin/python" ]]; then
  VENV_PY="$ROOT/.venv/bin/python"
elif [[ -x "/opt/scout-crew/.venv/bin/python" ]]; then
  VENV_PY="/opt/scout-crew/.venv/bin/python"
  ROOT="/opt/scout-crew"
else
  echo "scout: missing venv — run: cd ~/repo/scout_crew && crewai install" >&2
  echo "       or install system-wide: sudo ./install-debian.sh" >&2
  exit 1
fi

# Load environment
if [[ -f "$ROOT/.env" ]]; then
  set -a
  # shellcheck disable=SC1091
  source "$ROOT/.env"
  set +a
fi

# Force local-only LLM routing (hard guard)
export OPENAI_API_KEY="${OPENAI_API_KEY:-ollama}"
export OPENAI_API_BASE="${OPENAI_API_BASE:-http://127.0.0.1:11434/v1}"
export OPENAI_BASE_URL="${OPENAI_BASE_URL:-http://127.0.0.1:11434/v1}"
export OLLAMA_BASE_URL="${OLLAMA_BASE_URL:-http://127.0.0.1:11434}"
export CREWAI_TRACING_ENABLED="${CREWAI_TRACING_ENABLED:-true}"

# Hard-local guard: reject any non-local OpenAI base URLs
case "${OPENAI_BASE_URL}" in
  *11434*|*localhost*|*127.0.0.1*) ;;
  *)
    export OPENAI_BASE_URL="http://127.0.0.1:11434/v1"
    export OPENAI_API_BASE="http://127.0.0.1:11434/v1"
    export OPENAI_API_KEY="ollama"
    ;;
esac

# Ensure local bin on PATH for nested tools
export PATH="$ROOT/.venv/bin:$HOME/.local/bin:$PATH"

exec "$VENV_PY" -m scout_crew.cli "$@"