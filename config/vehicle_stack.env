# Vehicle Stack runtime configuration
# Copy and edit values per environment as needed.

# Pipeline integration
PIPELINE_LOG=/tmp/pipeline_live_doordash.log
ENABLE_PIPELINE_AUTOSTART=true
PIPELINE_MODE=direct
# Enable when real channels file contains valid stream URLs:
# PIPELINE_MODE=broadcastify
PIPELINE_EXTRA_ARGS='--channels-file /home/gibi/Desktop/config/broadcastify_channels.national.manifest.json --selector-city "Anacortes" --selector-county "Skagit County" --selector-state "WA" --selector-lat 48.5126 --selector-lon -122.6127 --no-selector-use-ollama-rerank'
BROADCASTIFY_CHANNELS_FILE=/home/gibi/Desktop/config/broadcastify_channels.national.manifest.json
BROADCASTIFY_SELECTOR_CITY="Anacortes"
BROADCASTIFY_SELECTOR_COUNTY="Skagit County"
BROADCASTIFY_SELECTOR_STATE="WA"
BROADCASTIFY_SELECTOR_DESIRED_TYPES=law,dispatch
BROADCASTIFY_SELECTOR_USE_OLLAMA_RERANK=false

# API/UI ports
BACKEND_PORT=18080
FRONTEND_PORT=8787
FRONTEND_EXECUTABLE_PATH=/home/gibi/Desktop/frontend/dist/scanner-frontend-lite/scanner-frontend-lite
FRONTEND_BUILD_ON_START=true

# Java backend networking
JAVA_BACKEND_HOST=0.0.0.0

# Log retention
MAX_LOG_SIZE_MB=32
MAX_LOG_BACKUPS=5
